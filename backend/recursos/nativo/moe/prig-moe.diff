+// AIPC_MOE_HOT_GGUF: the hot experts come from a higher-precision GGUF of the same base model
+// (only the hot copies; the rest of the model stays as loaded). Mapped read-only for the life of
+// the process, so a rehot can read other experts later.
+struct aipc_hq_source {
+    const uint8_t * base = nullptr;
+    size_t          size = 0;
+    gguf_context  * g    = nullptr;
+    ggml_context  * meta = nullptr;
+};
+
+static aipc_hq_source & aipc_hq() {
+    static aipc_hq_source src = [] {
+        aipc_hq_source r;
+        const char * path = std::getenv("AIPC_MOE_HOT_GGUF");
+        if (!path || !*path) {
+            return r;
+        }
+        gguf_init_params params = { /*.no_alloc =*/ true, /*.ctx =*/ &r.meta };
+        r.g = gguf_init_from_file(path, params);
+        const int fd = r.g ? open(path, O_RDONLY) : -1;
+        struct stat st;
+        if (fd >= 0 && fstat(fd, &st) == 0) {
+            void * p = mmap(nullptr, st.st_size, PROT_READ, MAP_SHARED, fd, 0);
+            if (p != MAP_FAILED) {
+                r.base = (const uint8_t *) p;
+                r.size = st.st_size;
+            }
+        }
+        if (fd >= 0) {
+            close(fd);
+        }
+        LLAMA_LOG_INFO("%s: AIPC hot experts from '%s': %s\n", __func__, path, r.base ? "ok" : "FAILED");
+        return r;
+    }();
+    return src;
+}
+
+// expert 0 of tensor `name` in the higher-precision GGUF if its shape matches `like`
+static bool aipc_hq_tensor(const char * name, const ggml_tensor * like, const uint8_t ** base, ggml_type * type, size_t * nb2) {
+    aipc_hq_source & hq = aipc_hq();
+    if (!hq.base) {
+        return false;
+    }
+    const int64_t id = gguf_find_tensor(hq.g, name);
+    const ggml_tensor * t = id >= 0 ? ggml_get_tensor(hq.meta, name) : nullptr;
+    if (!t || t->ne[0] != like->ne[0] || t->ne[1] != like->ne[1] || t->ne[2] != like->ne[2]) {
+        return false;
+    }
+    *type = gguf_get_tensor_type(hq.g, id);
+    *nb2  = ggml_row_size(*type, t->ne[0]) * t->ne[1];
+    *base = hq.base + gguf_get_data_offset(hq.g) + gguf_get_tensor_offset(hq.g, id);
+    return *base + *nb2 * t->ne[2] <= hq.base + hq.size;
+}
+
+int32_t llama_aipc_n_calientes(const struct llama_model * model) {
+    for (const auto & lay : model->layers) {
+        if (lay.ffn_up_exps) {
+            if (const aipc_moe_split * sp = aipc_moe_split_lookup(lay.ffn_up_exps)) {
+                return sp->n_hot;
+            }
+        }
+    }
+    return 0;
+}
+
+int32_t llama_aipc_rehot(struct llama_model * model, const int32_t * ids, int32_t n_capas, int32_t n_por_capa) {
+    int32_t cambiadas = 0;
+    for (int il = 0; il < n_capas && il < (int) model->layers.size(); il++) {
+        auto & lay = model->layers[il];
+        ggml_tensor * srcs[3] = { lay.ffn_up_exps, lay.ffn_gate_exps, lay.ffn_down_exps };
+        if (!srcs[0] || !srcs[1] || !srcs[2]) {
+            continue;
+        }
+        const aipc_moe_split * sp0 = aipc_moe_split_lookup(srcs[0]);
+        if (sp0 == nullptr || sp0->hot_b != nullptr) {
+            continue;                                  // sin reparto en esta capa (o con sesgos: no soportado)
+        }
+        const int n_hot    = sp0->n_hot;
+        const int n_expert = (int) srcs[0]->ne[2];
+        std::vector<int> nuevos;
+        std::vector<bool> visto(n_expert, false);
+        for (int i = 0; i < n_por_capa && (int) nuevos.size() < n_hot; i++) {
+            const int e = ids[(size_t) il * n_por_capa + i];
+            if (e >= 0 && e < n_expert && !visto[e]) {
+                visto[e] = true;
+                nuevos.push_back(e);
+            }
+        }
+        if ((int) nuevos.size() < n_hot) {
+            continue;                                  // la lista no llena los espacios: sin cambios
+        }
+        for (ggml_tensor * s : srcs) {
+            const aipc_moe_split * sp = aipc_moe_split_lookup(s);
+            if (sp == nullptr || s->data == nullptr) {
+                continue;
+            }
+            for (int i = 0; i < n_hot; i++) {
+                const char * desde = sp->hq_base ? (const char *) sp->hq_base + (size_t) nuevos[i] * sp->hq_nb2
+                                                 : (const char *) s->data   + (size_t) nuevos[i] * s->nb[2];
+                ggml_backend_tensor_set(sp->hot, desde, (size_t) i * sp->hot->nb[2], sp->hot->nb[2]);
+            }
+        }
+        std::vector<float> lk(n_expert, 0.0f), mk(n_expert, 0.0f);
+        for (int i = 0; i < n_hot; i++) {
+            lk[nuevos[i]] = (float) i;
+            mk[nuevos[i]] = 1.0f;
+        }
+        ggml_backend_tensor_set(sp0->lookup, lk.data(), 0, lk.size() * sizeof(float));
+        ggml_backend_tensor_set(sp0->mask,   mk.data(), 0, mk.size() * sizeof(float));
+        cambiadas++;
+    }
+    return cambiadas;
+}
