+static atomic_ullong g_aipc_calientes = 0, g_aipc_frias = 0;
+static int g_aipc_contar_cpu = -1;
+
+static void aipc_aciertos_contar(bool caliente) {
+    if (g_aipc_contar_cpu < 0) {
+        const char * e = getenv("AIPC_CONTAR");
+        g_aipc_contar_cpu = e && atoi(e) != 0;
